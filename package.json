{
	"name": "vkit",
	"private": true,
	"packageManager": "bun@1.4.2",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev:site": "bun run --cwd apps/site dev",
		"dev:storybook": "bun run --cwd apps/storybook dev",
		"build": "bun run --cwd apps/site build",
		"check-types": "bun run --filter '*' check-types",
		"lint": "bun run --filter '*' lint",
		"test": "bun run --cwd apps/site test"
	}
}
