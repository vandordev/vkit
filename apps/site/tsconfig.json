{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"types": ["vite/client", "bun"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.ts"],
	"exclude": ["node_modules", "dist"]
}
